// Verity data model — implements PRD section 20.
//
// ID convention: every primary key is a prefixed, URL-safe string generated by
// Postgres (`gen_random_uuid()` is core since PG13). Generating in the database
// rather than the application means no code path can create a row without an
// ID, including the Auth.js adapter, which does not supply one.

generator client {
  provider = "prisma-client-js"

  // Generated into the workspace rather than into node_modules/.pnpm, whose
  // path contains a content hash. A bundler can follow a normal relative
  // import and copy the query engine beside the output; it cannot reliably
  // find a hashed path, which is why the engine went missing at runtime while
  // the build itself succeeded.
  output = "../generated/client"

  // "native" covers local development. Vercel's functions run on Amazon Linux
  // and need their own engine built at generate time.
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING
}

enum OrgRole {
  ORG_ADMIN
  REQUESTER
  APPROVER
  AUDITOR
}

enum MemberStatus {
  ACTIVE
  DISABLED
}

enum ActionType {
  PAYMENT_REQUEST
  BANK_ACCOUNT_CHANGE
  PAYROLL_CHANGE
  ACCESS_CHANGE
  CONFIDENTIAL_DATA_DISCLOSURE
  CUSTOM
}

enum RequestStatus {
  DRAFT
  PENDING
  APPROVED
  DENIED
  EXPIRED
  CANCELED
  REVOKED
}

enum DecisionType {
  APPROVE
  DENY
  REVOKE
}

enum SourceType {
  GMAIL
  MANUAL
  API
}

enum WebAuthnChallengeType {
  REGISTRATION
  AUTHENTICATION
}

enum AuditEventType {
  ORGANIZATION_CREATED
  ORGANIZATION_SETTINGS_UPDATED
  POLICY_UPDATED
  INVITATION_CREATED
  INVITATION_RESENT
  INVITATION_REVOKED
  INVITATION_ACCEPTED
  ROLE_CHANGED
  USER_DISABLED
  USER_REACTIVATED
  PASSKEY_ADDED
  PASSKEY_REMOVED
  REQUEST_CREATED
  REQUEST_SUBMITTED
  REQUEST_VIEWED
  REQUEST_APPROVED
  REQUEST_DENIED
  REQUEST_EXPIRED
  REQUEST_CANCELED
  APPROVAL_REVOKED
  RECEIPT_VIEWED
  FAILED_APPROVAL_ATTEMPT
  AUTHORIZATION_FAILURE
}

// ---------------------------------------------------------------------------
// Identity — PRD 20.1
//
// Account / Session / VerificationToken are required by the Auth.js Prisma
// adapter. They hold session material only; no approval authority derives from
// them (approval always requires a passkey assertion).
// ---------------------------------------------------------------------------

model User {
  id    String @id @default(dbgenerated("('usr_' || replace(gen_random_uuid()::text, '-', ''))"))
  email String @unique

  // `name` and `emailVerified` are the field names the Auth.js Prisma adapter
  // writes to. The columns keep the PRD names (20.1).
  name          String?   @map("display_name")
  emailVerified DateTime? @map("email_verified_at")

  image     String?
  status    UserStatus @default(PENDING)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  accounts            Account[]
  sessions            Session[]
  memberships         OrganizationMember[]
  passkeys            PasskeyCredential[]
  webauthnChallenges  WebAuthnChallenge[]
  invitationsSent     Invitation[]          @relation("InvitationInvitedBy")
  requestsCreated     VerificationRequest[] @relation("RequestRequester")
  requestsToApprove   VerificationRequest[] @relation("RequestApprover")
  approvalChallenges  ApprovalChallenge[]
  decisions           Decision[]
  revocationsMade     Revocation[]
  auditEventsAsActor  AuditEvent[]

  @@map("users")
}

model Account {
  id                String  @id @default(dbgenerated("('acct_' || replace(gen_random_uuid()::text, '-', ''))"))
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(dbgenerated("('sess_' || replace(gen_random_uuid()::text, '-', ''))"))
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Organizations — PRD 20.2 - 20.4
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(dbgenerated("('org_' || replace(gen_random_uuid()::text, '-', ''))"))
  name      String
  slug      String   @unique
  domain    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members     OrganizationMember[]
  invitations Invitation[]
  requests    VerificationRequest[]
  auditEvents AuditEvent[]
  policy      OrganizationPolicy?

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(dbgenerated("('mem_' || replace(gen_random_uuid()::text, '-', ''))"))
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  role           OrgRole
  status         MemberStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, role])
  @@index([userId])
  @@map("organization_members")
}

/// Only the SHA-256 hash of the invitation token is stored; the raw token
/// exists solely in the invitation email (PRD 20.4).
model Invitation {
  id              String    @id @default(dbgenerated("('inv_' || replace(gen_random_uuid()::text, '-', ''))"))
  organizationId  String    @map("organization_id")
  email           String
  role            OrgRole
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  revokedAt       DateTime? @map("revoked_at")
  invitedByUserId String    @map("invited_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id])

  @@index([organizationId, email])
  @@index([email])
  @@map("invitations")
}

model OrganizationPolicy {
  id                                String   @id @default(dbgenerated("('pol_' || replace(gen_random_uuid()::text, '-', ''))"))
  organizationId                    String   @unique @map("organization_id")
  allowSelfApproval                 Boolean  @default(false) @map("allow_self_approval")
  defaultExpirationMinutes          Int      @default(60) @map("default_expiration_minutes")
  maximumExpirationMinutes          Int      @default(1440) @map("maximum_expiration_minutes")
  requirePasskeyEnrollment          Boolean  @default(true) @map("require_passkey_enrollment")
  verificationRecommendedThresholdMinor BigInt? @map("verification_recommended_threshold_minor")
  currency                          String   @default("USD")
  createdAt                         DateTime @default(now()) @map("created_at")
  updatedAt                         DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_policies")
}

// ---------------------------------------------------------------------------
// Passkeys — PRD 20.5
//
// Stores only public credential material. Private keys never leave the
// authenticator and biometric data is never transmitted to the server.
// ---------------------------------------------------------------------------

model PasskeyCredential {
  id           String    @id @default(dbgenerated("('cred_' || replace(gen_random_uuid()::text, '-', ''))"))
  userId       String    @map("user_id")
  credentialId String    @unique @map("credential_id")
  publicKey    Bytes     @map("public_key")
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  deviceType   String?   @map("device_type")
  backedUp     Boolean   @default(false) @map("backed_up")
  label        String
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")
  revokedAt    DateTime? @map("revoked_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  decisions Decision[]

  @@index([userId])
  @@map("passkey_credentials")
}

/// Short-lived, single-use WebAuthn challenge for registering a passkey or for
/// re-authenticating with one (PRD 14.2).
///
/// Not in the PRD data model, but required by its acceptance criteria:
/// "Registration challenges must expire" and "must be single use" cannot be
/// satisfied without server-side state. Decision challenges are separate —
/// they additionally bind a request and a payload hash, and live in
/// `ApprovalChallenge`.
///
/// The challenge value is a public nonce, not a secret; it is sent to the
/// browser by design, so it is stored as issued rather than hashed.
model WebAuthnChallenge {
  id        String                @id @default(dbgenerated("('wac_' || replace(gen_random_uuid()::text, '-', ''))"))
  userId    String                @map("user_id")
  type      WebAuthnChallengeType
  challenge String                @unique
  expiresAt DateTime              @map("expires_at")
  usedAt    DateTime?             @map("used_at")
  createdAt DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("webauthn_challenges")
}

// ---------------------------------------------------------------------------
// Verification requests — PRD 20.6
// ---------------------------------------------------------------------------

model VerificationRequest {
  id                     String        @id @default(dbgenerated("('req_' || replace(gen_random_uuid()::text, '-', ''))"))
  organizationId         String        @map("organization_id")
  requesterUserId        String        @map("requester_user_id")
  assignedApproverUserId String        @map("assigned_approver_user_id")
  actionType             ActionType    @map("action_type")
  status                 RequestStatus @default(DRAFT)

  displayTitle   String @map("display_title")
  displaySummary String @map("display_summary")

  /// Canonical, normalized protected payload. Immutable once the request
  /// leaves DRAFT; `payloadHash` is SHA-256 over its canonical serialization.
  protectedPayloadJson Json   @map("protected_payload_json")
  payloadHash          String @map("payload_hash")
  schemaVersion        Int    @default(1) @map("schema_version")
  nonce                String

  sourceType        SourceType @default(MANUAL) @map("source_type")
  sourceMessageId   String?    @map("source_message_id")
  sourceThreadId    String?    @map("source_thread_id")
  sourceSenderEmail String?    @map("source_sender_email")
  sourceSubject     String?    @map("source_subject")
  sourceUrl         String?    @map("source_url")

  expiresAt   DateTime  @map("expires_at")
  submittedAt DateTime? @map("submitted_at")
  approvedAt  DateTime? @map("approved_at")
  deniedAt    DateTime? @map("denied_at")
  canceledAt  DateTime? @map("canceled_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester    User                @relation("RequestRequester", fields: [requesterUserId], references: [id])
  approver     User                @relation("RequestApprover", fields: [assignedApproverUserId], references: [id])
  challenges   ApprovalChallenge[]
  decisions    Decision[]
  receipt      Receipt?
  revocation   Revocation?

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([assignedApproverUserId, status])
  @@index([requesterUserId])
  @@index([sourceThreadId])
  @@index([status, expiresAt])
  @@map("verification_requests")
}

// ---------------------------------------------------------------------------
// Decisions and challenges — PRD 20.7 - 20.8
// ---------------------------------------------------------------------------

/// A single-use, short-lived WebAuthn challenge bound to a specific request,
/// payload hash and decision (PRD FR-010). Only the hash of the serialized
/// challenge payload is stored.
model ApprovalChallenge {
  id            String       @id @default(dbgenerated("('chl_' || replace(gen_random_uuid()::text, '-', ''))"))
  requestId     String       @map("request_id")
  userId        String       @map("user_id")
  decision      DecisionType
  challengeHash String       @unique @map("challenge_hash")
  payloadHash   String       @map("payload_hash")
  expiresAt     DateTime     @map("expires_at")
  usedAt        DateTime?    @map("used_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  request VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([expiresAt])
  @@map("approval_challenges")
}

model Decision {
  id                        String       @id @default(dbgenerated("('dec_' || replace(gen_random_uuid()::text, '-', ''))"))
  requestId                 String       @map("request_id")
  approverUserId            String       @map("approver_user_id")
  credentialId              String       @map("credential_id")
  decision                  DecisionType
  payloadHash               String       @map("payload_hash")
  webauthnAssertionMetadata Json         @map("webauthn_assertion_metadata_json")
  reason                    String?
  createdAt                 DateTime     @default(now()) @map("created_at")

  // No cascade: a decision is evidence. Deleting the request it belongs to must
  // fail rather than quietly erase the record of who decided what.
  request    VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  approver   User                @relation(fields: [approverUserId], references: [id])
  credential PasskeyCredential   @relation(fields: [credentialId], references: [id])

  @@index([requestId])
  @@index([approverUserId])
  @@map("decisions")
}

// ---------------------------------------------------------------------------
// Receipts and revocations — PRD 20.9 - 20.10
// ---------------------------------------------------------------------------

model Receipt {
  id                 String   @id @default(dbgenerated("('rcpt_' || replace(gen_random_uuid()::text, '-', ''))"))
  requestId          String   @unique @map("request_id")
  receiptPayloadJson Json     @map("receipt_payload_json")
  receiptPayloadHash String   @map("receipt_payload_hash")
  serverSignature    String   @map("server_signature")
  signingKeyVersion  Int      @map("signing_key_version")
  createdAt          DateTime @default(now()) @map("created_at")

  request VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@map("receipts")
}

model Revocation {
  id              String   @id @default(dbgenerated("('rev_' || replace(gen_random_uuid()::text, '-', ''))"))
  requestId       String   @unique @map("request_id")
  revokedByUserId String   @map("revoked_by_user_id")
  reason          String
  credentialId    String?  @map("credential_id")
  createdAt       DateTime @default(now()) @map("created_at")

  request   VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  revokedBy User                @relation(fields: [revokedByUserId], references: [id])

  @@map("revocations")
}

// ---------------------------------------------------------------------------
// Audit — PRD 20.11
//
// Append-only. A database trigger (see migration `audit_append_only`) rejects
// UPDATE and DELETE so that no application code path, including a compromised
// one, can rewrite history.
// ---------------------------------------------------------------------------

model AuditEvent {
  id                   String         @id @default(dbgenerated("('evt_' || replace(gen_random_uuid()::text, '-', ''))"))
  organizationId       String?        @map("organization_id")
  actorUserId          String?        @map("actor_user_id")
  eventType            AuditEventType @map("event_type")
  targetType           String         @map("target_type")
  targetId             String?        @map("target_id")
  metadata             Json           @default("{}")
  previousState        String?        @map("previous_state")
  newState             String?        @map("new_state")
  requestCorrelationId String?        @map("request_correlation_id")
  ipHash               String?        @map("ip_hash")
  userAgent            String?        @map("user_agent")
  createdAt            DateTime       @default(now()) @map("created_at")

  // Restrict on both sides. An append-only table cannot honour a cascade
  // delete or a SET NULL, so the referenced rows must not be deletable either.
  // Users and organizations are disabled, never removed.
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([targetType, targetId])
  @@index([eventType])
  @@map("audit_events")
}
