# ---------------------------------------------------------------------------
# Verity — environment variables
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# Every variable the application reads is documented here (PRD NFR-006).
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Local development uses the Postgres container in docker-compose.yml.
# Production must use an encrypted connection (append ?sslmode=require).
DATABASE_URL="postgresql://verity:verity@localhost:5433/verity?schema=public"

# --- Application URLs ------------------------------------------------------
# Public origin of the web app. Used for links in emails and for WebAuthn
# origin verification. Must be https in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# --- Session / Auth.js -----------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# --- WebAuthn / passkeys (PRD Milestone 2) ---------------------------------
# RP_ID is the registrable domain, WITHOUT scheme or port. "localhost" in dev.
RP_ID="localhost"
RP_NAME="Verity"
# Comma-separated list of origins allowed to produce WebAuthn assertions.
EXPECTED_ORIGIN="http://localhost:3000"

# --- Email delivery --------------------------------------------------------
# When RESEND_API_KEY is empty, outbound mail is written to the server log
# instead of being sent. That fallback is refused in production.
RESEND_API_KEY=""
EMAIL_FROM="Verity <no-reply@example.com>"

# --- Receipt signing (PRD Milestone 4) -------------------------------------
# Ed25519 private key, base64-encoded PKCS#8. Generate with:
#   node -e "const{generateKeyPairSync}=require('crypto');const{privateKey}=generateKeyPairSync('ed25519');console.log(privateKey.export({type:'pkcs8',format:'der'}).toString('base64'))"
# NEVER commit this value. Rotate by incrementing the key version.
RECEIPT_SIGNING_KEY=""
RECEIPT_SIGNING_KEY_VERSION="1"

# --- Feature flags ---------------------------------------------------------
# Action types requesters may choose (PRD 13). Payment requests and
# bank-account changes are the two the MVP commits to. The remaining types
# (PAYROLL_CHANGE, ACCESS_CHANGE, CONFIDENTIAL_DATA_DISCLOSURE, CUSTOM) are
# implemented but stay off until their flows are finished.
ENABLED_ACTION_TYPES="PAYMENT_REQUEST,BANK_ACCOUNT_CHANGE"

# --- Chrome extension ------------------------------------------------------
# Comma-separated extension origins allowed to call /api/extension/*, e.g.
# "chrome-extension://abcdefghijklmnopabcdefghijklmnop". Find the ID on
# chrome://extensions after loading the unpacked build. Leave empty to refuse
# every extension. There is no wildcard on purpose: the ID is the only thing
# distinguishing your extension from anybody else's.
EXTENSION_ORIGINS=""
